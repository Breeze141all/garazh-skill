# Нужен только для озвучки (voice/build.mjs, render.mjs --voice). Достаточно ОДНОГО ключа:
# OpenRouter (https://openrouter.ai/keys) — TTS + проверка слов --check
# Скопируй в .env и впиши свой ключ. .env в git не коммитится.
OPENROUTER_API_KEY=
# …или напрямую Fish Audio (https://fish.audio → API keys): работают и приватные голоса аккаунта
FISH_AUDIO_API_KEY=
